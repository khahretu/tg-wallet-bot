const sqlite3 = require('sqlite3').verbose();
const db = new sqlite3.Database('./shorturls.db');

db.run(`CREATE TABLE IF NOT EXISTS shorturls (
  id TEXT PRIMARY KEY,
  target TEXT,
  cloak TEXT,
  device_rules TEXT,
  clicks INTEGER DEFAULT 0,
  created_at TEXT
)`);

// Redirect endpoint
app.get('/s/:id', (req, res) => {
  const id = req.params.id;
  db.get('SELECT target, cloak, device_rules FROM shorturls WHERE id = ?', [id], (err, row) => {
    if (err || !row) return res.status(404).send('Not found');
    // Simple device detection (can be enhanced)
    const ua = req.headers['user-agent'];
    let finalUrl = row.target;
    if (row.cloak && ua.includes('bot')) finalUrl = row.cloak;
    db.run('UPDATE shorturls SET clicks = clicks + 1 WHERE id = ?', [id]);
    res.redirect(finalUrl);
  });
});
